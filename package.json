{
  "name": "wisteria-cli",
  "version": "1.0.0",
  "description": "Monorepo task runner with parallel execution, interactive console, and extensible command system",
  "main": "dist/cli.js",
  "types": "dist/cli.d.ts",
  "bin": {
    "wisteria": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/public-api.js",
      "types": "./dist/public-api.d.ts"
    }
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "doc": "typedoc --out docs src/public-api.ts",
    "prepare": "husky",
    "prepublishOnly": "pnpm run build && pnpm run test"
  },
  "keywords": [
    "monorepo",
    "task-runner",
    "parallel",
    "workspace",
    "cli",
    "pnpm",
    "orchestrator"
  ],
  "author": "NiRBES02",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/NiRBES02/wisteria-cli.git"
  },
  "bugs": {
    "url": "https://github.com/NiRBES02/wisteria-cli/issues"
  },
  "homepage": "https://github.com/NiRBES02/wisteria-cli#readme",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@stylistic/eslint-plugin": "^2.6.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "chalk": "^6.0.1",
    "cli-progress": "^3.12.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.9.0",
    "eslint-plugin-import": "^2.29.1",
    "execa": "^10.0.1",
    "husky": "^9.1.0",
    "levenshtein": "^1.0.5",
    "lint-staged": "^15.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typedoc": "^0.26.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0",
    "wrap-ansi": "^10.0.2"
  },
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  }
}
